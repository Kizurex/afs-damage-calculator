# Normalise line endings so the site behaves the same on every OS
* text=auto eol=lf

*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary

# Generated data: collapse in diffs and skip language statistics
data/gamedata.js linguist-generated=true -diff
data/changelog.js linguist-generated=true -diff
assets/icons/manifest.json linguist-generated=true
